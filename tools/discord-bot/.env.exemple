# Copie ce fichier en .env et remplis-le. NE PARTAGE JAMAIS le .env (jeton du bot + mot de passe de la base).
DISCORD_TOKEN=colle_ici_le_jeton_du_bot
NOM_SERVEUR=LUSO RP

# Gangs et entreprises du projet FiveM (un role + des salons prives chacun)
# dossier qb-core/shared du serveur (gangs.lua, jobs.lua)
QBCORE_SHARED=/root/fivem/server/txData/gtarp2/resources/[Project-Terrific]/[core-important]/qb-core/shared
# base du serveur : utilisateur en LECTURE SEULE conseille (voir LISEZMOI.md)
DB_URL=mysql://lusobot:MOT_DE_PASSE@localhost/projectterrific
# metiers sans salon dedie (petits boulots), separes par des virgules
METIERS_SANS_SALON=bus,garbage,hotdog,trucker,vineyard

# Liaison jeu -> Discord (Twitter, Leboncoin, annonces RP, ouvertures d'entreprises) : le bot ecrit les webhooks ici
WEBHOOKS_CFG=/root/fivem/server/txData/gtarp2/webhooks.cfg

# Statut du serveur FiveM (salon statut-serveur, mis a jour chaque minute)
FIVEM_IP=127.0.0.1
FIVEM_PORT=30120
FIVEM_MAX=64
# lien pour se connecter (cfx.re/join/xxxxxx), affiche sur le bouton "Se connecter"
CONNECT_URL=
# image en bas de l'embed de bienvenue (lien direct vers une image, facultatif)
IMAGE_BIENVENUE=
